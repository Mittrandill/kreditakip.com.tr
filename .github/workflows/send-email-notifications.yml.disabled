name: Send Email Notifications

on:
  schedule:
    # Her gün 09:00 ve 18:00 UTC'de çalış
    - cron: '0 9 * * *'
    - cron: '0 18 * * *'
  workflow_dispatch:
    inputs:
      test_mode:
        description: 'Test mode (true/false)'
        required: false
        default: 'false'
      test_email:
        description: 'Test email address'
        required: false

jobs:
  send-notifications:
    runs-on: ubuntu-latest
    
    steps:
    - name: Checkout code
      uses: actions/checkout@v4
      
    - name: Setup Node.js
      uses: actions/setup-node@v4
      with:
        node-version: '18'
        
    - name: Install dependencies
      run: |
        npm install mailersend @supabase/supabase-js
        
    - name: Send Email Notifications
      env:
        MAILERSEND_API_KEY: ${{ secrets.MAILERSEND_API_KEY }}
        NEXT_PUBLIC_SUPABASE_URL: ${{ secrets.NEXT_PUBLIC_SUPABASE_URL }}
        NEXT_PUBLIC_SUPABASE_ANON_KEY: ${{ secrets.NEXT_PUBLIC_SUPABASE_ANON_KEY }}
        SERVICE_ROLE_KEY: ${{ secrets.SERVICE_ROLE_KEY }}
        TEST_MODE: ${{ github.event.inputs.test_mode || 'false' }}
        TEST_EMAIL: ${{ github.event.inputs.test_email }}
      run: |
        echo "📂 Current working directory: $(pwd)"
        echo "📋 Listing repository contents:"
        ls -la
        echo "📁 Checking scripts directory:"
        ls -la scripts/
        echo "🔍 Verifying script file exists:"
        if [ -f "scripts/send-email-notifications.js" ]; then
          echo "✅ Script file found"
          echo "📄 Script file details:"
          ls -la scripts/send-email-notifications.js
        else
          echo "❌ Script file not found"
          exit 1
        fi
        echo "🚀 Running email notification script..."
        node scripts/send-email-notifications.js
        
    - name: Workflow Summary
      if: always()
      run: |
        echo "📊 Email Notification Workflow Summary"
        echo "======================================"
        echo "Workflow completed at: $(date)"
        echo "Test Mode: ${{ env.TEST_MODE }}"
        if [ "${{ env.TEST_MODE }}" = "true" ]; then
          echo "Test Email: ${{ env.TEST_EMAIL }}"
        fi
