# ⚠️ SECURITY WARNING: Never commit .env.local to git!
# Copy this file to .env.local and fill in your actual values

# Encryption (Generate a secure random 32-byte base64 key)
# IMPORTANT: Do NOT use NEXT_PUBLIC_ prefix for encryption keys!
ENCRYPTION_KEY=your-secure-32-byte-base64-encryption-key-here

# For Cron Job
CRON_SECRET=your-cron-job-secret-key

# Email Service (Choose one)
MAILJET_API_KEY=your-mailjet-api-key
MAILJET_SECRET_KEY=your-mailjet-secret-key
MAILERSEND_API_KEY=your-mailersend-api-key
RESEND_API_KEY=your-resend-api-key
NEXT_PUBLIC_MAILERSEND_URL=https://api.mailersend.com/v1/

# Test Mode
TEST_MODE=your-test-email@example.com
TEST_EMAIL=your-test-email@example.com

# Supabase
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SERVICE_ROLE_KEY=your-supabase-service-role-key

# App URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://www.kreditakip.com.tr

# Paddle Payment Gateway
NEXT_PUBLIC_PADDLE_VENDOR_ID=your-paddle-vendor-id
NEXT_PUBLIC_PADDLE_ENVIRONMENT=sandbox
PADDLE_VENDOR_AUTH_CODE=your-paddle-vendor-auth-code
NEXT_PUBLIC_PADDLE_CHECKOUT_URL=https://sandbox-checkout.paddle.com/checkout/custom
PADDLE_PUBLIC_KEY=your-paddle-public-key-for-webhook-verification
PADDLE_API_KEY=your_paddle_api_key

# For Production:
# NEXT_PUBLIC_PADDLE_ENVIRONMENT=production
# NEXT_PUBLIC_PADDLE_CHECKOUT_URL=https://checkout.paddle.com/checkout/custom

# PayTR Payment Gateway (DEPRECATED - Now using Paddle)
# PAYTR_MERCHANT_ID=your-paytr-merchant-id
# PAYTR_MERCHANT_KEY=your-paytr-merchant-key
# PAYTR_MERCHANT_SALT=your-paytr-merchant-salt
# PAYTR_TEST_MODE=0

# Google Gemini AI (for OCR)
GEMINI_API_KEY=your-gemini-api-key

# Instructions:
# 1. Copy this file: cp .env.example .env.local
# 2. Fill in all values with your actual credentials
# 3. NEVER commit .env.local to git
# 4. For production, use environment variables in your hosting platform (Vercel, etc.)
# 5. Rotate all keys immediately if they are ever exposed
