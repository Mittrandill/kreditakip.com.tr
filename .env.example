# ⚠️ SECURITY WARNING: Never commit .env.local to git!
# Copy this file to .env.local and fill in your actual values

# Encryption (Generate a secure random 32-byte base64 key)
# IMPORTANT: Do NOT use NEXT_PUBLIC_ prefix for encryption keys!
ENCRYPTION_KEY=your-secure-32-byte-base64-encryption-key-here

# Email Service (Choose one)
MAILJET_API_KEY=your-mailjet-api-key
MAILJET_SECRET_KEY=your-mailjet-secret-key
MAILERSEND_API_KEY=your-mailersend-api-key
RESEND_API_KEY=your-resend-api-key
NEXT_PUBLIC_MAILERSEND_URL=https://api.mailersend.com/v1/

# Test Mode
TEST_MODE=your-test-email@example.com
TEST_EMAIL=your-test-email@example.com

# Supabase
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SERVICE_ROLE_KEY=your-supabase-service-role-key

# App URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=your-supabase-project-url

# iyzico Payment (Sandbox for testing, Production for live)
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com
IYZICO_SECRET_KEY=your-iyzico-secret-key
IYZICO_API_KEY=your-iyzico-api-key

# Google Gemini AI (for OCR)
GEMINI_API_KEY=your-gemini-api-key

# Instructions:
# 1. Copy this file: cp .env.example .env.local
# 2. Fill in all values with your actual credentials
# 3. NEVER commit .env.local to git
# 4. For production, use environment variables in your hosting platform (Vercel, etc.)
# 5. Rotate all keys immediately if they are ever exposed
