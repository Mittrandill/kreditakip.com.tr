# ⚠️ SECURITY WARNING: Never commit .env.local to git!
# Copy this file to .env.local and fill in your actual values

# Encryption (Generate a secure random 32-byte base64 key)
# IMPORTANT: Do NOT use NEXT_PUBLIC_ prefix for encryption keys!
ENCRYPTION_KEY=your-secure-32-byte-base64-encryption-key-here

# For Cron Job
CRON_SECRET=your-cron-job-secret-key

# Email Service (Choose one)
MAILJET_API_KEY=your-mailjet-api-key
MAILJET_SECRET_KEY=your-mailjet-secret-key
MAILERSEND_API_KEY=your-mailersend-api-key
RESEND_API_KEY=your-resend-api-key
NEXT_PUBLIC_MAILERSEND_URL=https://api.mailersend.com/v1/

# Test Mode
TEST_MODE=your-test-email@example.com
TEST_EMAIL=your-test-email@example.com

# Supabase
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SERVICE_ROLE_KEY=your-supabase-service-role-key

# App URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://www.kreditakip.com.tr

# Paddle Payment Gateway
# =====================================================
# IMPORTANT: For LIVE/PRODUCTION mode, use these settings:
# =====================================================

# Paddle Environment - CRITICAL: Change to 'production' for live mode
NEXT_PUBLIC_PADDLE_ENVIRONMENT=production

# Paddle Client Token (Get from Paddle Dashboard > Developer Tools > Authentication)
# This is your CLIENT-SIDE token that starts with 'live_' for production
# REQUIRED for Paddle.js to initialize on the frontend
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=your_live_paddle_client_token

# Paddle Vendor/Client ID (Get from Paddle Dashboard > Developer Tools > Authentication)
# Format: Your Client ID (starts with 'biz_' or numeric for legacy)
# OPTIONAL: May not be needed for Paddle Billing API
NEXT_PUBLIC_PADDLE_VENDOR_ID=your-live-paddle-client-id

# Paddle API Key - LIVE (Get from Paddle Dashboard > Developer Tools > Authentication)
# IMPORTANT: Use your LIVE API key, NOT sandbox key
# This is your SERVER-SIDE key for backend API calls
# Format: Starts with 'live_' for production or 'test_' for sandbox
PADDLE_API_KEY=your_live_paddle_api_key

# Paddle Webhook Secret Key (Get from Paddle Dashboard > Notifications > Notification Settings)
# Used to verify webhook signatures
# IMPORTANT: Copy the 'Notification secret token' from your LIVE webhook destination
PADDLE_WEBHOOK_SECRET=your_live_paddle_webhook_secret_key

# Paddle Checkout URL - LIVE
NEXT_PUBLIC_PADDLE_CHECKOUT_URL=https://buy.paddle.com/checkout

# DEPRECATED - Legacy fields (not used in Paddle Billing API)
# PADDLE_VENDOR_AUTH_CODE=your-paddle-vendor-auth-code
# PADDLE_PUBLIC_KEY=your-paddle-public-key-for-webhook-verification

# =====================================================
# For SANDBOX/TEST mode, use these settings instead:
# =====================================================
# NEXT_PUBLIC_PADDLE_ENVIRONMENT=sandbox
# NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=test_your_sandbox_paddle_client_token
# NEXT_PUBLIC_PADDLE_VENDOR_ID=your-sandbox-paddle-client-id
# PADDLE_API_KEY=test_your_sandbox_paddle_api_key
# PADDLE_WEBHOOK_SECRET=your_sandbox_paddle_webhook_secret_key
# NEXT_PUBLIC_PADDLE_CHECKOUT_URL=https://sandbox-buy.paddle.com/checkout

# PayTR Payment Gateway (For new subscriptions, Paddle still active for existing)
PAYTR_MERCHANT_ID=your-paytr-merchant-id
PAYTR_MERCHANT_KEY=your-paytr-merchant-key
PAYTR_MERCHANT_SALT=your-paytr-merchant-salt
PAYTR_TEST_MODE=0

# Google Gemini AI (for OCR)
GEMINI_API_KEY=your-gemini-api-key

# Instructions:
# 1. Copy this file: cp .env.example .env.local
# 2. Fill in all values with your actual credentials
# 3. NEVER commit .env.local to git
# 4. For production, use environment variables in your hosting platform (Vercel, etc.)
# 5. Rotate all keys immediately if they are ever exposed
