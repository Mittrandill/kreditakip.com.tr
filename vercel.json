{
  "buildCommand": "npm run build",
  "functions": {
    "app/api/**/*.ts": {
      "maxDuration": 30
    },
    "app/api/cron/**/*.ts": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/subscription-reminder",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/subscription-expiry-check",
      "schedule": "0 10 * * *"
    }
  ]
}
