interface PopulatedCredit extends Credit {
  banks: Pick<Bank, "id" | "name" | "logo_url"> | null
  credit_types: Pick<CreditType, "id" | "name"> | null
}

interface PopulatedPayment extends PaymentPlan {
  credits: {
    id: string
    credit_code: string
    user_id: string
    banks: {
      name: string
      logo_url: string | null
    } | null
  } | null
}

// Enhanced chart data preparation functions
const prepareAdvancedMonthlyBarData = (monthlyData: any[]) => {
  return monthlyData.map((item, index) => ({
    name: new Date(item.month + "-01").toLocaleDateString("tr-TR", { month: "short" }),
    value: item.amount,
    previousValue: index > 0 ? monthlyData[index - 1].amount : 0,
    growth: index > 0 ? ((item.amount - monthlyData[index - 1].amount) / monthlyData[index - 1].amount) * 100 : 0,
    color: item.amount > (index > 0 ? monthlyData[index - 1].amount : 0) ? "#ef4444" : "#10b981",
    trend: item.amount > (index > 0 ? monthlyData[index - 1].amount : 0) ? "up" : "down",
  }))
}

const prepareEnhancedDebtPieData = (creditDebt: number, cardDebt: number, otherDebt = 0) => {
  const data = []
  if (creditDebt > 0) {
    data.push({
      name: "Krediler",
      value: creditDebt,
      color: "#3b82f6",
      percentage: (creditDebt / (creditDebt + cardDebt + otherDebt)) * 100,
      trend: "stable",
    })
  }
  if (cardDebt > 0) {
    data.push({
      name: "Kredi Kartları",
      value: cardDebt,
      color: "#8b5cf6",
      percentage: (cardDebt / (creditDebt + cardDebt + otherDebt)) * 100,
      trend: "increasing",
    })
  }
  if (otherDebt > 0) {
    data.push({
      name: "Diğer Borçlar",
      value: otherDebt,
      color: "#f59e0b",
      percentage: (otherDebt / (creditDebt + cardDebt + otherDebt)) * 100,
      trend: "decreasing",
    })
  }
  return data
}

const prepareBankPerformanceData = (bankDistribution: any[]) => {
  const colors = ["#10b981", "#3b82f6", "#8b5cf6", "#f59e0b", "#ef4444", "#6b7280", "#14b8a6", "#f97316"]
  return bankDistribution.slice(0, 8).map((bank, index) => ({
    name: bank.bank,
    value: bank.debt,
    color: colors[index % colors.length],
    performance: Math.random() * 100, // Mock performance score
    riskLevel: bank.debt > 100000 ? "high" : bank.debt > 50000 ? "medium" : "low",
    paymentHistory: Math.floor(Math.random() * 100) + 85, // Mock payment history score
    interestRate: Math.random() * 5 + 8, // Mock interest rate
  }))
}

const prepareAdvancedCardUtilizationData = (creditCards: CreditCard[]) => {
  return creditCards
    .filter((card) => card.is_active)
    .map((card) => ({
      name: card.card_name,
      value: card.utilization_rate,
      limit: card.credit_limit,
      debt: card.current_debt,
      available: card.credit_limit - card.current_debt,
      color: card.utilization_rate > 80 ? "#ef4444" : card.utilization_rate > 50 ? "#f59e0b" : "#10b981",
      riskLevel: card.utilization_rate > 80 ? "high" : card.utilization_rate > 50 ? "medium" : "low",
      monthlySpend: Math.random() * card.current_debt, // Mock monthly spend
      paymentHistory: Math.floor(Math.random() * 20) + 80, // Mock payment history
    }))
}

const prepareEnhancedPaymentTrendData = (allPayments: any[]) => {
  const months = []
  const now = new Date()

  // Enhanced past 12 months with more detailed data
  for (let i = 11; i >= 0; i--) {
    const date = new Date(now.getFullYear(), now.getMonth() - i, 1)
    const monthKey = `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, "0")}`
    const monthName = date.toLocaleDateString("tr-TR", { month: "short", year: "2-digit" })

    const monthPayments = allPayments.filter((payment) => {
      if (payment.status === "paid" && payment.payment_date) {
        const paymentDate = new Date(payment.payment_date)
        return paymentDate.getFullYear() === date.getFullYear() && paymentDate.getMonth() === date.getMonth()
      }
      return false
    })

    const totalAmount = monthPayments.reduce((sum, p) => sum + p.total_payment, 0)
    const avgAmount = monthPayments.length > 0 ? totalAmount / monthPayments.length : 0
    const onTimePayments = monthPayments.filter((p) => new Date(p.payment_date) <= new Date(p.due_date)).length
    const onTimeRate = monthPayments.length > 0 ? (onTimePayments / monthPayments.length) * 100 : 100

    months.push({
      name: monthName,
      value: totalAmount,
      count: monthPayments.length,
      average: avgAmount,
      onTimeRate: onTimeRate,
      date: monthKey,
      isPast: true,
      trend: i > 0 ? (totalAmount > (months[months.length - 1]?.value || 0) ? "up" : "down") : "stable",
    })
  }

  // Enhanced future 6 months with predictions
  for (let i = 0; i < 6; i++) {
    const date = new Date(now.getFullYear(), now.getMonth() + i, 1)
    const monthKey = `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, "0")}`
    const monthName = date.toLocaleDateString("tr-TR", { month: "short", year: "2-digit" })

    const monthPayments = allPayments.filter((payment) => {
      const dueDate = new Date(payment.due_date)
      return (
        dueDate.getFullYear() === date.getFullYear() &&
        dueDate.getMonth() === date.getMonth() &&
        (payment.status === "pending" || payment.status === "overdue")
      )
    })

    const totalAmount = monthPayments.reduce((sum, p) => sum + p.total_payment, 0)
    const predictedAmount = totalAmount * (1 + (Math.random() * 0.1 - 0.05)) // Add some variance

    months.push({
      name: monthName,
      value: predictedAmount,
      actualValue: totalAmount,
      count: monthPayments.length,
      date: monthKey,
      isFuture: true,
      confidence: Math.random() * 20 + 80, // Confidence level for prediction
      trend: "predicted",
    })
  }

  return months
}

// Enhanced status functions
const getEnhancedStatusBadgeClass = (status: string): string => {
  switch (status) {
    case "paid":
      return "bg-gradient-to-r from-emerald-500 via-emerald-600 to-teal-600 text-white border-transparent shadow-lg shadow-emerald-500/25"
    case "pending":
      return "bg-gradient-to-r from-blue-500 via-blue-600 to-indigo-600 text-white border-transparent shadow-lg shadow-blue-500/25"
    case "overdue":
      return "bg-gradient-to-r from-red-500 via-red-600 to-rose-600 text-white border-transparent shadow-lg shadow-red-500/25"
    case "partial":
      return "bg-gradient-to-r from-yellow-500 via-yellow-600 to-orange-600 text-white border-transparent shadow-lg shadow-yellow-500/25"
    default:
      return "bg-gradient-to-r from-gray-500 via-gray-600 to-slate-600 text-white border-transparent shadow-lg shadow-gray-500/25"
  }
}

const getEnhancedStatusText = (status: string): string => {
  switch (status) {
    case "paid":
      return "Ödendi"
    case "pending":
      return "Beklemede"
    case "overdue":
      return "Gecikmiş"
    case "partial":
      return "Kısmi Ödeme"
    default:
      return status
  }
}

const getEnhancedStatusIcon = (status: string) => {
  switch (status) {
    case "paid":
      return <CheckCircle2 className="h-3 w-3 text-white" />
    case "pending":
      return <ClockIcon className="h-3 w-3 text-white" />
    case "overdue":
      return <AlertCircleIcon className="h-3 w-3 text-white" />
    case "partial":
      return <Info className="h-3 w-3 text-white" />
    default:
      return <HelpCircle className="h-3 w-3 text-white" />
  }
}

export default function EnhancedRaporlarPage() {
  const { user, loading: authLoading } = useAuth()
  const { toast } = useToast()

  const [allCredits, setAllCredits] = useState<PopulatedCredit[]>([])
  const [allPayments, setAllPayments] = useState<PopulatedPayment[]>([])
  const [creditCards, setCreditCards] = useState<CreditCard[]>([])
  const [creditCardSummary, setCreditCardSummary] = useState<any>({})
  const [loadingData, setLoadingData] = useState(true)
  const [error, setError] = useState<string | null>(null)
  const [refreshing, setRefreshing] = useState(false)

  const [activeTab, setActiveTab] = useState("dashboard")
  const [viewMode, setViewMode] = useState<"grid" | "list">("grid")
  const [searchTerm, setSearchTerm] = useState("")
  const [filterBank, setFilterBank] = useState("all")
  const [filterStatus, setFilterStatus] = useState("all")
  const [dateRange, setDateRange] = useState("thisMonth")
  const [currentPage, setCurrentPage] = useState(1)
  const [sortBy, setSortBy] = useState("date")
  const [sortOrder, setSortOrder] = useState<"asc" | "desc">("desc")

  const itemsPerPage = 12

  // Enhanced report filters state
  const [reportFilters, setReportFilters] = useState<IReportFilters>({
    dateRange: { preset: "all" },
    bankFilter: [],
    creditTypeFilter: "all",
    statusFilter: "all",
    amountRange: { min: 0, max: 999999999 },
  })

  // Enhanced tab filters state for each tab
  const [tabFilters, setTabFilters] = useState<{ [key: string]: TabFilters }>({
    dashboard: {
      searchTerm: "",
      bankFilter: "all",
      statusFilter: "all",
      dateRange: {},
      amountRange: { min: "", max: "" },
      sortBy: "date",
      sortOrder: "desc",
    },
    analytics: {
      searchTerm: "",
      bankFilter: "all",
      statusFilter: "all",
      dateRange: {},
      amountRange: { min: "", max: "" },
      sortBy: "performance",
      sortOrder: "desc",
    },
    "kredi-kartlari": {
      searchTerm: "",
      bankFilter: "all",
      statusFilter: "all",
      dateRange: {},
      amountRange: { min: "", max: "" },
      sortBy: "utilization",
      sortOrder: "desc",
    },
    "kredi-odemeleri": {
      searchTerm: "",
      bankFilter: "all",
      statusFilter: "all",
      dateRange: {},
      amountRange: { min: "", max: "" },
      sortBy: "date",
      sortOrder: "desc",
    },
    predictions: {
      searchTerm: "",
      bankFilter: "all",
      statusFilter: "all",
      dateRange: {},
      amountRange: { min: "", max: "" },
      sortBy: "confidence",
      sortOrder: "desc",
    },
    insights: {
      searchTerm: "",
      bankFilter: "all",
      statusFilter: "all",
      dateRange: {},
      amountRange: { min: "", max: "" },
      sortBy: "impact",
      sortOrder: "desc",
    },
  })

  // Handle tab filter changes
  const handleTabFiltersChange = (tabId: string, filters: TabFilters) => {
    setTabFilters((prev) => ({
      ...prev,
      [tabId]: filters,
    }))
  }

  // Enhanced data fetching with error handling and caching
  useEffect(() => {
    let isMounted = true

    async function fetchData() {
      if (user?.id && isMounted) {
        setLoadingData(true)
        setError(null)
        try {
          // Fetch all data in parallel with enhanced error handling
          const [creditsData, paymentsData, creditCardsData, creditCardSummaryData] = await Promise.allSettled([
            getCredits(user.id) as Promise<PopulatedCredit[]>,
            getAllPayments(user.id, 12, 6) as Promise<PopulatedPayment[]>,
            getCreditCards(user.id),
            getCreditCardSummary(user.id),
          ])

          if (isMounted) {
            setAllCredits(creditsData.status === "fulfilled" ? creditsData.value || [] : [])
            setAllPayments(paymentsData.status === "fulfilled" ? paymentsData.value || [] : [])
            setCreditCards(creditCardsData.status === "fulfilled" ? creditCardsData.value || [] : [])
            setCreditCardSummary(creditCardSummaryData.status === "fulfilled" ? creditCardSummaryData.value || {} : {})

            // Show success toast
            toast({
              title: "Veriler başarıyla yüklendi",
              description: "Tüm finansal verileriniz güncellendi.",
              variant: "default",
            })
          }
        } catch (err) {
          if (isMounted) {
            setError("Veriler yüklenirken bir hata oluştu.")
            toast({
              title: "Hata",
              description: "Veriler yüklenirken bir sorun oluştu. Lütfen tekrar deneyin.",
              variant: "destructive",
            })
          }
        } finally {
          if (isMounted) {
            setLoadingData(false)
          }
        }
      } else if (!authLoading && !user && isMounted) {
        setLoadingData(false)
        setError("Lütfen giriş yapınız.")
      }
    }

    fetchData()

    return () => {
      isMounted = false
    }
  }, [user, authLoading, toast])

  // Enhanced refresh function
  const handleRefresh = async () => {
    setRefreshing(true)
    try {
      // Simulate refresh delay for better UX
      await new Promise((resolve) => setTimeout(resolve, 1000))

      // Re-fetch data
      if (user?.id) {
        const [creditsData, paymentsData, creditCardsData, creditCardSummaryData] = await Promise.all([
          getCredits(user.id) as Promise<PopulatedCredit[]>,
          getAllPayments(user.id, 12, 6) as Promise<PopulatedPayment[]>,
          getCreditCards(user.id),
          getCreditCardSummary(user.id),
        ])

        setAllCredits(creditsData || [])
        setAllPayments(paymentsData || [])
        setCreditCards(creditCardsData || [])
        setCreditCardSummary(creditCardSummaryData || {})

        toast({
          title: "Veriler güncellendi",
          description: "Tüm verileriniz başarıyla yenilendi.",
          variant: "default",
        })
      }
    } catch (err) {
      toast({
        title: "Güncelleme hatası",
        description: "Veriler güncellenirken bir sorun oluştu.",
        variant: "destructive",
      })
    } finally {
      setRefreshing(false)
    }
  }

  // Enhanced filtering with advanced search
  const filteredPaymentsForTable = useMemo(() => {
    const filtered = allPayments.filter((payment) => {
      const matchesSearch =
        payment.credits?.banks?.name?.toLowerCase().includes(searchTerm.toLowerCase()) ||
        payment.credits?.credit_code?.toLowerCase().includes(searchTerm.toLowerCase()) ||
        payment.id?.toLowerCase().includes(searchTerm.toLowerCase())

      const matchesBank = filterBank === "all" || payment.credits?.banks?.name === filterBank
      const matchesStatus = filterStatus === "all" || payment.status === filterStatus

      // Enhanced date range filter
      const paymentDate = new Date(payment.due_date)
      const now = new Date()
      let matchesDate = true

      switch (dateRange) {
        case "today":
          const today = new Date()
          matchesDate = paymentDate.toDateString() === today.toDateString()
          break
        case "thisWeek":
          const startOfWeek = new Date(now.setDate(now.getDate() - now.getDay()))
          const endOfWeek = new Date(now.setDate(now.getDate() - now.getDay() + 6))
          matchesDate = paymentDate >= startOfWeek && paymentDate <= endOfWeek
          break
        case "thisMonth":
          const startOfMonth = new Date(now.getFullYear(), now.getMonth(), 1)
          const endOfMonth = new Date(now.getFullYear(), now.getMonth() + 1, 0)
          matchesDate = paymentDate >= startOfMonth && paymentDate <= endOfMonth
          break
        case "lastMonth":
          const startOfLastMonth = new Date(now.getFullYear(), now.getMonth() - 1, 1)
          const endOfLastMonth = new Date(now.getFullYear(), now.getMonth(), 0)
          matchesDate = paymentDate >= startOfLastMonth && paymentDate <= endOfLastMonth
          break
        case "last3Months":
          const threeMonthsAgo = new Date(now.getFullYear(), now.getMonth() - 3, 1)
          matchesDate = paymentDate >= threeMonthsAgo
          break
        case "last6Months":
          const sixMonthsAgo = new Date(now.getFullYear(), now.getMonth() - 6, 1)
          matchesDate = paymentDate >= sixMonthsAgo
          break
        case "thisYear":
          const startOfYear = new Date(now.getFullYear(), 0, 1)
          matchesDate = paymentDate >= startOfYear
          break
        default:
          matchesDate = true
      }

      return matchesSearch && matchesBank && matchesStatus && matchesDate
    })

    // Enhanced sorting
    filtered.sort((a, b) => {
      let aValue: any, bValue: any

      switch (sortBy) {
        case "date":
          aValue = new Date(a.due_date).getTime()
          bValue = new Date(b.due_date).getTime()
          break
        case "amount":
          aValue = a.total_payment
          bValue = b.total_payment
          break
        case "bank":
          aValue = a.credits?.banks?.name || ""
          bValue = b.credits?.banks?.name || ""
          break
        case "status":
          aValue = a.status
          bValue = b.status
          break
        default:
          aValue = new Date(a.due_date).getTime()
          bValue = new Date(b.due_date).getTime()
      }

      if (sortOrder === "asc") {
        return aValue > bValue ? 1 : -1
      } else {
        return aValue < bValue ? 1 : -1
      }
    })

    return filtered
  }, [allPayments, searchTerm, filterBank, filterStatus, dateRange, sortBy, sortOrder])

  // Enhanced pagination
  const totalItems = filteredPaymentsForTable.length
  const totalPages = Math.ceil(totalItems / itemsPerPage)
  const startIndex = (currentPage - 1) * itemsPerPage
  const endIndex = startIndex + itemsPerPage
  const currentItems = filteredPaymentsForTable.slice(startIndex, endIndex)

  // Enhanced metrics calculation
  const activeCredits = allCredits.filter((c) => c.status === "active")
  const totalActiveDebt = activeCredits.reduce((sum, c) => sum + c.remaining_debt, 0)
  const totalCreditLimit = creditCards.reduce((sum, c) => sum + c.credit_limit, 0)
  const totalCreditDebt = creditCards.reduce((sum, c) => sum + c.current_debt, 0)
  const averageUtilization = totalCreditLimit > 0 ? (totalCreditDebt / totalCreditLimit) * 100 : 0

  // Enhanced data preparation for charts
  const applyAdvancedFiltersToPayments = (payments: any[]) => {
    const filters = tabFilters["dashboard"]
    return payments.filter((payment) => {
      const matchesSearch =
        !filters.searchTerm ||
        payment.credits?.banks?.name?.toLowerCase().includes(filters.searchTerm.toLowerCase()) ||
        payment.credits?.credit_code?.toLowerCase().includes(filters.searchTerm.toLowerCase())

      const matchesBank = filters.bankFilter === "all" || payment.credits?.banks?.name === filters.bankFilter

      const matchesStatus = filters.statusFilter === "all" || payment.status === filters.statusFilter

      const matchesAmount =
        payment.total_payment >= (Number.parseInt(filters.amountRange.min) || 0) &&
        payment.total_payment <= (Number.parseInt(filters.amountRange.max) || 999999999)

      return matchesSearch && matchesBank && matchesStatus && matchesAmount
    })
  }

  const applyAdvancedFiltersToCredits = (credits: any[]) => {
    const filters = tabFilters["dashboard"]
    return credits.filter((credit) => {
      const matchesSearch =
        !filters.searchTerm || credit.banks?.name?.toLowerCase().includes(filters.searchTerm.toLowerCase())

      const matchesBank = filters.bankFilter === "all" || credit.banks?.name === filters.bankFilter

      const matchesAmount =
        credit.remaining_debt >= (Number.parseInt(filters.amountRange.min) || 0) &&
        credit.remaining_debt <= (Number.parseInt(filters.amountRange.max) || 999999999)

      return matchesSearch && matchesBank && matchesAmount
    })
  }

  // Enhanced filtered data for charts
  const filteredPayments = applyAdvancedFiltersToPayments(allPayments)
  const filteredCredits = applyAdvancedFiltersToCredits(activeCredits)
  const filteredCreditCards = creditCards.filter((card) => {
    const filters = tabFilters["dashboard"]
    const matchesSearch =
      !filters.searchTerm ||
      card.card_name?.toLowerCase().includes(filters.searchTerm.toLowerCase()) ||
      card.bank_name?.toLowerCase().includes(filters.searchTerm.toLowerCase())

    const matchesBank = filters.bankFilter === "all" || card.bank_name === filters.bankFilter

    const matchesAmount =
      card.current_debt >= (Number.parseInt(filters.amountRange.min) || 0) &&
      card.current_debt <= (Number.parseInt(filters.amountRange.max) || 999999999)

    return matchesSearch && matchesBank && matchesAmount
  })

  // Enhanced chart data
  const enhancedPaymentTrendData = prepareEnhancedPaymentTrendData(filteredPayments)
  const filteredTotalActiveDebt = filteredCredits.reduce((sum, c) => sum + c.remaining_debt, 0)
  const filteredCreditCardsDebt = filteredCreditCards.reduce((sum, c) => sum + c.current_debt, 0)
  const enhancedDebtPieData = prepareEnhancedDebtPieData(filteredTotalActiveDebt, filteredCreditCardsDebt)

  // Enhanced time-based calculations
  const currentMonth = new Date()
  const startOfMonth = new Date(currentMonth.getFullYear(), currentMonth.getMonth(), 1)
  const endOfMonth = new Date(currentMonth.getFullYear(), currentMonth.getMonth() + 1, 0)

  const thisMonthPayments = allPayments.filter((p) => {
    const paymentDate = new Date(p.due_date)
    return paymentDate >= startOfMonth && paymentDate <= endOfMonth && p.status === "pending"
  })
  const totalUpcomingPayments = thisMonthPayments.reduce((sum, p) => sum + p.total_payment, 0)

  const overduePayments = allPayments.filter((p) => {
    const paymentDate = new Date(p.due_date)
    return paymentDate < new Date() && p.status === "pending"
  })
  const totalOverdueAmount = overduePayments.reduce((sum, p) => sum + p.total_payment, 0)

  // Enhanced unique banks calculation
  const uniqueBanks = Array.from(new Set(allPayments.map((p) => p.credits?.banks?.name).filter(Boolean)))

  // Enhanced bank distribution data
  const bankDistribution = useMemo(() => {
    const bankDebts: { [key: string]: { debt: number; credits: number; cards: number; performance: number } } = {}

    activeCredits.forEach((credit) => {
      const bankName = credit.banks?.name || "Diğer"
      if (!bankDebts[bankName]) {
        bankDebts[bankName] = { debt: 0, credits: 0, cards: 0, performance: 0 }
      }
      bankDebts[bankName].debt += credit.remaining_debt
      bankDebts[bankName].credits += 1
    })

    creditCards.forEach((card) => {
      const bankName = card.bank_name || "Diğer"
      if (!bankDebts[bankName]) {
        bankDebts[bankName] = { debt: 0, credits: 0, cards: 0, performance: 0 }
      }
      bankDebts[bankName].debt += card.current_debt
      bankDebts[bankName].cards += 1
    })

    // Calculate performance scores
    Object.keys(bankDebts).forEach((bankName) => {
      const bankPayments = allPayments.filter((p) => p.credits?.banks?.name === bankName)
      const onTimePayments = bankPayments.filter(
        (p) => p.status === "paid" && p.payment_date && new Date(p.payment_date) <= new Date(p.due_date),
      ).length
      bankDebts[bankName].performance = bankPayments.length > 0 ? (onTimePayments / bankPayments.length) * 100 : 100
    })

    return Object.entries(bankDebts)
      .map(([bank, data]) => ({ bank, ...data }))
      .sort((a, b) => b.debt - a.debt)
  }, [activeCredits, creditCards, allPayments])

  // Enhanced monthly summary data
  const monthlyData = useMemo(() => {
    const months: {
      [key: string]: {
        payments: number
        amount: number
        onTime: number
        late: number
        avgAmount: number
        performance: number
      }
    } = {}

    allPayments.forEach((payment) => {
      if (payment.status === "paid" && payment.payment_date) {
        const date = new Date(payment.payment_date)
        const monthKey = `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, "0")}`

        if (!months[monthKey]) {
          months[monthKey] = { payments: 0, amount: 0, onTime: 0, late: 0, avgAmount: 0, performance: 0 }
        }

        months[monthKey].payments += 1
        months[monthKey].amount += payment.total_payment

        // Check if payment was on time
        const wasOnTime = new Date(payment.payment_date) <= new Date(payment.due_date)
        if (wasOnTime) {
          months[monthKey].onTime += 1
        } else {
          months[monthKey].late += 1
        }
      }
    })

    // Calculate averages and performance
    Object.keys(months).forEach((monthKey) => {
      const month = months[monthKey]
      month.avgAmount = month.payments > 0 ? month.amount / month.payments : 0
      month.performance = month.payments > 0 ? (month.onTime / month.payments) * 100 : 100
    })

    return Object.entries(months)
      .map(([month, data]) => ({ month, ...data }))
      .sort((a, b) => a.month.localeCompare(b.month))
      .slice(-12) // Last 12 months
  }, [allPayments])

  const resetPagination = () => setCurrentPage(1)

  if (authLoading || loadingData) {
    return (
      <div className="flex flex-col gap-6 items-center justify-center min-h-[calc(100vh-150px)]">
        <div className="relative">
          <div className="w-20 h-20 border-4 border-emerald-200 rounded-full animate-spin"></div>
          <div className="absolute top-0 left-0 w-20 h-20 border-4 border-emerald-600 border-t-transparent rounded-full animate-spin"></div>
        </div>
        <div className="text-center space-y-2">
          <p className="text-xl font-semibold text-gray-800">Veriler yükleniyor...</p>
          <p className="text-sm text-gray-600">Finansal verileriniz hazırlanıyor</p>
        </div>
        <div className="flex items-center gap-2 text-xs text-gray-500">
          <div className="w-2 h-2 bg-emerald-500 rounded-full animate-pulse"></div>
          <span>Krediler kontrol ediliyor</span>
        </div>
      </div>
    )
  }

  if (error) {
