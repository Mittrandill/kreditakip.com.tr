                    </Badge>
                    <Badge className="bg-purple-500/20 text-purple-300 border-purple-500/30">
                      <Award className="h-3 w-3 mr-1" />
                      Premium
                    </Badge>
                  </div>
                </div>
              </div>

              <p className="text-xl text-gray-300 max-w-3xl mb-8 leading-relaxed">
