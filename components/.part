                title="Aktif Kart"
                value={formatNumber(creditCardSummary.activeCards || 0)}
                subtitle={`${creditCards.length} toplam kart`}
                color="purple"
                icon={<CreditCardIcon />}
                trend={{ value: 0, isPositive: true }}
                className="hover:scale-105 transition-transform duration-300"
              />
            </div>

            {/* Advanced Credit Card Analytics */}
            <div className="grid grid-cols-1 lg:grid-cols-2 gap-6">
              <Card className="shadow-xl hover:shadow-2xl transition-all duration-300 hover:scale-[1.02] rounded-2xl border-0 bg-gradient-to-br from-white to-violet-50">
                <CardHeader>
                  <div className="flex items-center gap-3">
                    <div className="p-3 bg-violet-100 rounded-xl shadow-md">
                      <PieChart className="h-6 w-6 text-violet-600" />
                    </div>
                    <div>
                      <CardTitle className="text-xl font-bold text-gray-900">Kart Kullanım Optimizasyonu</CardTitle>
                      <CardDescription className="text-sm text-gray-600">Akıllı kullanım önerileri</CardDescription>
                    </div>
                  </div>
                </CardHeader>
                <CardContent>
                  <DataVisualization
                    type="utilization-gauge"
                    data={prepareAdvancedCardUtilizationData(filteredCreditCards)}
                    height={350}
                    showOptimizationTips={true}
                  />
                </CardContent>
              </Card>

              <Card className="shadow-xl hover:shadow-2xl transition-all duration-300 hover:scale-[1.02] rounded-2xl border-0 bg-gradient-to-br from-white to-emerald-50">
                <CardHeader>
                  <div className="flex items-center gap-3">
                    <div className="p-3 bg-emerald-100 rounded-xl shadow-md">
                      <BarChart3 className="h-6 w-6 text-emerald-600" />
                    </div>
                    <div>
                      <CardTitle className="text-xl font-bold text-gray-900">Kart Performans Karşılaştırması</CardTitle>
                      <CardDescription className="text-sm text-gray-600">Detaylı performans analizi</CardDescription>
                    </div>
                  </div>
                </CardHeader>
                <CardContent>
                  <DataVisualization
                    type="performance-comparison"
                    data={filteredCreditCards.slice(0, 6).map((card) => ({
                      name: card.card_name.length > 12 ? card.card_name.substring(0, 12) + "..." : card.card_name,
                      debt: card.current_debt,
                      limit: card.credit_limit,
                      utilization: card.utilization_rate,
                      performance: Math.random() * 40 + 60, // Mock performance score
                    }))}
                    height={350}
                  />
                </CardContent>
              </Card>
            </div>

            {/* Enhanced Credit Cards Table */}
            <Card className="shadow-xl rounded-2xl border-0">
              <CardHeader>
                <div className="flex items-center justify-between">
                  <div className="flex items-center gap-3">
                    <div className="p-2 bg-purple-100 rounded-lg">
                      <CreditCardIcon className="h-5 w-5 text-purple-600" />
                    </div>
                    <CardTitle className="text-xl font-bold text-gray-900">Kredi Kartı Detay Analizi</CardTitle>
                  </div>
                  <Badge variant="outline" className="border-purple-200 text-purple-700">
                    {creditCards.length} Kart
                  </Badge>
                </div>
              </CardHeader>
              <CardContent>
                <CustomizableWidgets
                  type="credit-cards-table"
                  data={creditCards}
                  columns={[
                    { key: "card_name", label: "Kart Adı", sortable: true },
                    { key: "bank_name", label: "Banka", sortable: true },
                    { key: "credit_limit", label: "Limit", sortable: true, format: "currency" },
                    { key: "current_debt", label: "Borç", sortable: true, format: "currency" },
                    { key: "utilization_rate", label: "Kullanım %", sortable: true, format: "percentage" },
                    { key: "is_active", label: "Durum", sortable: true, format: "status" },
                  ]}
                  pageSize={10}
                  showFilters={true}
                  showExport={true}
                />
              </CardContent>
            </Card>
          </TabsContent>

          {/* Enhanced Credit Payments Tab */}
          <TabsContent value="kredi-odemeleri" className="p-6 space-y-8">
            <SmartFilters
              tabId="kredi-odemeleri"
              filters={tabFilters["kredi-odemeleri"]}
              onFiltersChange={(filters) => handleTabFiltersChange("kredi-odemeleri", filters)}
              availableBanks={uniqueBanks}
              availableStatuses={[
                { value: "all", label: "Tüm Durumlar" },
                { value: "paid", label: "Ödendi" },
                { value: "pending", label: "Beklemede" },
                { value: "overdue", label: "Gecikmiş" },
                { value: "partial", label: "Kısmi Ödeme" },
              ]}
              showAmountFilter={true}
              showDateFilter={true}
            />

            {/* Payment Analytics Dashboard */}
            <div className="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
              <Card className="bg-gradient-to-br from-emerald-50 to-emerald-100 border-emerald-200 shadow-lg">
                <CardContent className="p-6">
                  <div className="flex items-center gap-4">
                    <div className="p-3 bg-emerald-500 rounded-full">
                      <CheckCircle2 className="h-6 w-6 text-white" />
                    </div>
                    <div>
                      <p className="text-sm font-medium text-emerald-700">Başarılı Ödemeler</p>
                      <p className="text-2xl font-bold text-emerald-900">
                        {allPayments.filter((p) => p.status === "paid").length}
                      </p>
                      <p className="text-xs text-emerald-600">
                        {formatCurrency(
                          allPayments.filter((p) => p.status === "paid").reduce((sum, p) => sum + p.total_payment, 0),
                        )}
                      </p>
                    </div>
                  </div>
                </CardContent>
              </Card>

              <Card className="bg-gradient-to-br from-blue-50 to-blue-100 border-blue-200 shadow-lg">
                <CardContent className="p-6">
                  <div className="flex items-center gap-4">
                    <div className="p-3 bg-blue-500 rounded-full">
                      <ClockIcon className="h-6 w-6 text-white" />
                    </div>
                    <div>
                      <p className="text-sm font-medium text-blue-700">Bekleyen Ödemeler</p>
                      <p className="text-2xl font-bold text-blue-900">
                        {allPayments.filter((p) => p.status === "pending").length}
                      </p>
                      <p className="text-xs text-blue-600">
                        {formatCurrency(
                          allPayments
                            .filter((p) => p.status === "pending")
                            .reduce((sum, p) => sum + p.total_payment, 0),
                        )}
                      </p>
                    </div>
                  </div>
                </CardContent>
              </Card>

              <Card className="bg-gradient-to-br from-red-50 to-red-100 border-red-200 shadow-lg">
                <CardContent className="p-6">
                  <div className="flex items-center gap-4">
                    <div className="p-3 bg-red-500 rounded-full">
                      <AlertCircleIcon className="h-6 w-6 text-white" />
                    </div>
                    <div>
                      <p className="text-sm font-medium text-red-700">Geciken Ödemeler</p>
                      <p className="text-2xl font-bold text-red-900">{overduePayments.length}</p>
                      <p className="text-xs text-red-600">{formatCurrency(totalOverdueAmount)}</p>
                    </div>
                  </div>
                </CardContent>
              </Card>
            </div>

            {/* Enhanced Payments Table */}
            <Card className="shadow-xl rounded-2xl border-0">
              <CardHeader>
                <div className="flex items-center justify-between">
                  <div className="flex items-center gap-3">
                    <div className="p-2 bg-emerald-100 rounded-lg">
                      <FileText className="h-5 w-5 text-emerald-600" />
                    </div>
                    <CardTitle className="text-xl font-bold text-gray-900">Gelişmiş Ödeme Geçmişi</CardTitle>
                  </div>
                  <div className="flex items-center gap-2">
                    <Badge variant="outline" className="border-emerald-600/30 text-emerald-600">
                      {filteredPaymentsForTable.length} kayıt
                    </Badge>
                    <Button variant="outline" size="sm" className="h-8 bg-transparent">
                      <Download className="h-4 w-4 mr-1" />
                      Excel
                    </Button>
                  </div>
                </div>
              </CardHeader>
              <CardContent>
                {currentItems.length === 0 ? (
                  <div className="text-center py-12">
                    <div className="p-4 bg-gray-100 rounded-full w-fit mx-auto mb-4">
                      <FileText className="h-12 w-12 text-gray-400" />
                    </div>
                    <h3 className="text-lg font-semibold text-gray-900 mb-2">Ödeme Kaydı Bulunamadı</h3>
                    <p className="text-gray-600 mb-4">
                      {searchTerm || filterBank !== "all" || filterStatus !== "all" || dateRange !== "all"
                        ? "Bu filtrelere uygun ödeme kaydı bulunamadı."
                        : "Henüz ödeme kaydı bulunmuyor."}
                    </p>
                    <Button
                      variant="outline"
                      onClick={() => {
                        setSearchTerm("")
                        setFilterBank("all")
                        setFilterStatus("all")
                        setDateRange("all")
                      }}
                    >
                      Filtreleri Temizle
                    </Button>
                  </div>
                ) : (
                  <div className="space-y-6">
                    <div className="overflow-x-auto">
                      <Table>
                        <TableHeader>
                          <TableRow className="bg-gradient-to-r from-gray-50 to-white">
                            <TableHead className="font-bold text-gray-800">
                              <Button
                                variant="ghost"
                                size="sm"
                                onClick={() => {
                                  setSortBy("bank")
                                  setSortOrder(sortBy === "bank" && sortOrder === "asc" ? "desc" : "asc")
                                }}
                              >
                                Banka
                                {sortBy === "bank" &&
                                  (sortOrder === "asc" ? (
                                    <ChevronUp className="h-4 w-4 ml-1" />
                                  ) : (
                                    <ChevronDown className="h-4 w-4 ml-1" />
                                  ))}
                              </Button>
                            </TableHead>
                            <TableHead className="font-bold text-gray-800">Kredi Kodu</TableHead>
                            <TableHead className="font-bold text-gray-800">
                              <Button
                                variant="ghost"
                                size="sm"
                                onClick={() => {
                                  setSortBy("date")
                                  setSortOrder(sortBy === "date" && sortOrder === "asc" ? "desc" : "asc")
                                }}
                              >
                                Vade Tarihi
                                {sortBy === "date" &&
                                  (sortOrder === "asc" ? (
                                    <ChevronUp className="h-4 w-4 ml-1" />
                                  ) : (
                                    <ChevronDown className="h-4 w-4 ml-1" />
                                  ))}
                              </Button>
                            </TableHead>
                            <TableHead className="font-bold text-gray-800">Taksit No</TableHead>
                            <TableHead className="font-bold text-gray-800">
                              <Button
                                variant="ghost"
                                size="sm"
                                onClick={() => {
                                  setSortBy("amount")
                                  setSortOrder(sortBy === "amount" && sortOrder === "asc" ? "desc" : "asc")
                                }}
                              >
                                Tutar
                                {sortBy === "amount" &&
                                  (sortOrder === "asc" ? (
                                    <ChevronUp className="h-4 w-4 ml-1" />
                                  ) : (
                                    <ChevronDown className="h-4 w-4 ml-1" />
                                  ))}
                              </Button>
                            </TableHead>
                            <TableHead className="font-bold text-gray-800">
                              <Button
                                variant="ghost"
                                size="sm"
                                onClick={() => {
                                  setSortBy("status")
                                  setSortOrder(sortBy === "status" && sortOrder === "asc" ? "desc" : "asc")
                                }}
                              >
                                Durum
                                {sortBy === "status" &&
                                  (sortOrder === "asc" ? (
                                    <ChevronUp className="h-4 w-4 ml-1" />
                                  ) : (
                                    <ChevronDown className="h-4 w-4 ml-1" />
                                  ))}
                              </Button>
                            </TableHead>
                            <TableHead className="font-bold text-gray-800">Ödeme Tarihi</TableHead>
                            <TableHead className="font-bold text-gray-800 text-right">İşlemler</TableHead>
                          </TableRow>
                        </TableHeader>
                        <TableBody>
                          {currentItems.map((payment, index) => (
                            <TableRow
                              key={payment.id}
                              className={`hover:bg-emerald-50 transition-all duration-200 ${
                                index % 2 === 0 ? "bg-white" : "bg-gray-50/50"
                              } hover:shadow-md`}
                            >
                              <TableCell>
                                <div className="flex items-center gap-3">
                                  <BankLogo
                                    bankName={payment.credits?.banks?.name || "Bilinmeyen Banka"}
                                    logoUrl={payment.credits?.banks?.logo_url}
                                    size="sm"
                                    className="ring-2 ring-emerald-200 bg-white shadow-sm"
                                  />
                                  <div>
                                    <span className="font-semibold text-gray-900">
                                      {payment.credits?.banks?.name || "N/A"}
                                    </span>
                                    <p className="text-xs text-gray-500">ID: {payment.id?.substring(0, 8)}...</p>
                                  </div>
                                </div>
                              </TableCell>
                              <TableCell>
                                <div className="font-mono text-sm bg-gray-100 px-2 py-1 rounded">
                                  {payment.credits?.credit_code || "N/A"}
                                </div>
                              </TableCell>
                              <TableCell>
                                <div className="flex flex-col">
                                  <span className="font-medium text-gray-900">
                                    {new Date(payment.due_date).toLocaleDateString("tr-TR")}
                                  </span>
                                  <span className="text-xs text-gray-500">
                                    {new Date(payment.due_date).toLocaleDateString("tr-TR", { weekday: "short" })}
                                  </span>
                                </div>
                              </TableCell>
                              <TableCell>
                                <Badge variant="outline" className="font-mono">
                                  {payment.installment_number}
                                </Badge>
                              </TableCell>
                              <TableCell>
                                <div className="flex flex-col">
                                  <span className="font-bold text-gray-900">
                                    {formatCurrency(payment.total_payment)}
                                  </span>
                                  <span className="text-xs text-gray-500">
                                    Ana: {formatCurrency(payment.principal_payment || 0)}
                                  </span>
                                </div>
                              </TableCell>
                              <TableCell>
                                <Badge
                                  className={`${getEnhancedStatusBadgeClass(payment.status)} flex items-center gap-1 w-fit`}
                                >
                                  {getEnhancedStatusIcon(payment.status)}
                                  {getEnhancedStatusText(payment.status)}
                                </Badge>
                              </TableCell>
                              <TableCell>
                                <div className="flex flex-col">
                                  <span className="text-gray-900">
                                    {payment.payment_date
                                      ? new Date(payment.payment_date).toLocaleDateString("tr-TR")
                                      : "-"}
                                  </span>
                                  {payment.payment_date && (
                                    <span className="text-xs text-gray-500">
                                      {new Date(payment.payment_date).toLocaleDateString("tr-TR", { weekday: "short" })}
                                    </span>
                                  )}
                                </div>
                              </TableCell>
                              <TableCell className="text-right">
                                <div className="flex items-center justify-end gap-1">
                                  <Button
                                    variant="ghost"
                                    size="sm"
                                    className="text-emerald-600 hover:text-emerald-700 hover:bg-emerald-50 h-8 w-8 p-0"
                                  >
                                    <Eye className="h-4 w-4" />
                                  </Button>
                                  <Button
                                    variant="ghost"
                                    size="sm"
                                    className="text-blue-600 hover:text-blue-700 hover:bg-blue-50 h-8 w-8 p-0"
                                  >
                                    <Edit className="h-4 w-4" />
                                  </Button>
                                  <Button
                                    variant="ghost"
                                    size="sm"
                                    className="text-gray-600 hover:text-gray-700 hover:bg-gray-50 h-8 w-8 p-0"
                                  >
                                    <MoreHorizontal className="h-4 w-4" />
                                  </Button>
                                </div>
                              </TableCell>
                            </TableRow>
                          ))}
                        </TableBody>
                      </Table>
                    </div>

                    {totalPages > 1 && (
                      <PaginationModern
                        currentPage={currentPage}
                        totalPages={totalPages}
                        totalItems={totalItems}
                        itemsPerPage={itemsPerPage}
                        onPageChange={setCurrentPage}
                        itemName="ödeme"
                      />
                    )}
                  </div>
                )}
              </CardContent>
            </Card>
          </TabsContent>

          {/* AI Predictions Tab */}
          <TabsContent value="predictions" className="p-6 space-y-8">
            <SmartFilters
              tabId="predictions"
              filters={tabFilters["predictions"]}
              onFiltersChange={(filters) => handleTabFiltersChange("predictions", filters)}
              availableBanks={uniqueBanks}
              showAdvancedOptions={true}
            />

            <PredictiveAnalytics
              historicalData={allPayments}
              creditData={allCredits}
              creditCardData={creditCards}
              timeHorizon={12}
            />
          </TabsContent>

          {/* AI Insights Tab */}
          <TabsContent value="insights" className="p-6 space-y-8">
            <SmartFilters
              tabId="insights"
              filters={tabFilters["insights"]}
              onFiltersChange={(filters) => handleTabFiltersChange("insights", filters)}
              availableBanks={uniqueBanks}
              showAdvancedOptions={true}
            />

            <div className="grid grid-cols-1 lg:grid-cols-3 gap-6">
              {/* AI-Powered Recommendations */}
              <Card className="lg:col-span-2 shadow-xl rounded-2xl border-0 bg-gradient-to-br from-white to-emerald-50">
                <CardHeader>
                  <div className="flex items-center gap-3">
                    <div className="p-3 bg-emerald-100 rounded-xl shadow-md">
                      <Zap className="h-6 w-6 text-emerald-600" />
                    </div>
                    <div>
                      <CardTitle className="text-xl font-bold text-gray-900">AI Önerileri</CardTitle>
                      <CardDescription className="text-sm text-gray-600">
                        Kişiselleştirilmiş finansal öneriler
                      </CardDescription>
                    </div>
                  </div>
                </CardHeader>
                <CardContent className="space-y-4">
                  <div className="p-4 bg-emerald-100 rounded-xl border border-emerald-200">
                    <div className="flex items-start gap-3">
                      <div className="p-2 bg-emerald-500 rounded-lg">
                        <Target className="h-4 w-4 text-white" />
                      </div>
                      <div>
                        <h4 className="font-semibold text-emerald-800">Öncelikli Aksiyon</h4>
                        <p className="text-sm text-emerald-700 mt-1">
                          Kredi kartı borcunuzu %{Math.round(averageUtilization)}den %30'un altına indirerek kredi
                          puanınızı artırabilirsiniz.
                        </p>
                        <div className="flex items-center gap-2 mt-2">
                          <Badge className="bg-emerald-500 text-white">Yüksek Etki</Badge>
                          <span className="text-xs text-emerald-600">
                            Tahmini tasarruf: {formatCurrency(Math.random() * 5000 + 2000)}
                          </span>
                        </div>
                      </div>
                    </div>
                  </div>

                  <div className="p-4 bg-blue-100 rounded-xl border border-blue-200">
                    <div className="flex items-start gap-3">
                      <div className="p-2 bg-blue-500 rounded-lg">
                        <Calculator className="h-4 w-4 text-white" />
                      </div>
                      <div>
                        <h4 className="font-semibold text-blue-800">Ödeme Optimizasyonu</h4>
                        <p className="text-sm text-blue-700 mt-1">
                          Aylık ödeme planınızı yeniden düzenleyerek {formatCurrency(Math.random() * 1000 + 500)}{" "}
                          tasarruf edebilirsiniz.
                        </p>
                        <div className="flex items-center gap-2 mt-2">
                          <Badge className="bg-blue-500 text-white">Orta Etki</Badge>
                          <span className="text-xs text-blue-600">Uygulama süresi: 2-3 ay</span>
                        </div>
                      </div>
                    </div>
                  </div>

                  <div className="p-4 bg-purple-100 rounded-xl border border-purple-200">
                    <div className="flex items-start gap-3">
                      <div className="p-2 bg-purple-500 rounded-lg">
                        <PiggyBank className="h-4 w-4 text-white" />
                      </div>
                      <div>
                        <h4 className="font-semibold text-purple-800">Uzun Vadeli Strateji</h4>
                        <p className="text-sm text-purple-700 mt-1">
                          Borç konsolidasyonu ile faiz oranlarınızı %{(Math.random() * 3 + 1).toFixed(1)}{" "}
                          düşürebilirsiniz.
                        </p>
                        <div className="flex items-center gap-2 mt-2">
                          <Badge className="bg-purple-500 text-white">Uzun Vadeli</Badge>
                          <span className="text-xs text-purple-600">
                            Potansiyel tasarruf: {formatCurrency(Math.random() * 10000 + 5000)}
                          </span>
                        </div>
                      </div>
                    </div>
                  </div>
                </CardContent>
              </Card>

              {/* Risk Assessment */}
              <Card className="shadow-xl rounded-2xl border-0 bg-gradient-to-br from-white to-orange-50">
                <CardHeader>
                  <div className="flex items-center gap-3">
                    <div className="p-3 bg-orange-100 rounded-xl shadow-md">
                      <Shield className="h-6 w-6 text-orange-600" />
                    </div>
                    <div>
                      <CardTitle className="text-xl font-bold text-gray-900">Risk Değerlendirmesi</CardTitle>
                      <CardDescription className="text-sm text-gray-600">Finansal risk analizi</CardDescription>
                    </div>
                  </div>
                </CardHeader>
                <CardContent className="space-y-4">
                  <div className="text-center">
                    <div className="relative w-32 h-32 mx-auto mb-4">
                      <svg className="w-32 h-32 transform -rotate-90" viewBox="0 0 36 36">
                        <path
                          d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831"
                          fill="none"
                          stroke="#e5e7eb"
                          strokeWidth="2"
                        />
                        <path
                          d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831"
                          fill="none"
                          stroke="#10b981"
                          strokeWidth="2"
                          strokeDasharray="75, 100"
                        />
                      </svg>
                      <div className="absolute inset-0 flex items-center justify-center">
                        <div className="text-center">
                          <div className="text-2xl font-bold text-emerald-600">75</div>
                          <div className="text-xs text-gray-500">Risk Skoru</div>
                        </div>
                      </div>
                    </div>
                    <Badge className="bg-emerald-100 text-emerald-700 border-emerald-200">Düşük Risk</Badge>
                  </div>

                  <div className="space-y-3">
                    <div className="flex items-center justify-between">
                      <span className="text-sm text-gray-600">Ödeme Geçmişi</span>
                      <div className="flex items-center gap-2">
                        <div className="w-16 bg-gray-200 rounded-full h-2">
                          <div className="bg-emerald-500 h-2 rounded-full" style={{ width: "92%" }}></div>
                        </div>
                        <span className="text-sm font-medium text-emerald-600">92%</span>
                      </div>
                    </div>

                    <div className="flex items-center justify-between">
                      <span className="text-sm text-gray-600">Borç/Gelir Oranı</span>
                      <div className="flex items-center gap-2">
                        <div className="w-16 bg-gray-200 rounded-full h-2">
                          <div className="bg-yellow-500 h-2 rounded-full" style={{ width: "65%" }}></div>
                        </div>
                        <span className="text-sm font-medium text-yellow-600">65%</span>
                      </div>
                    </div>

                    <div className="flex items-center justify-between">
                      <span className="text-sm text-gray-600">Kredi Kullanımı</span>
                      <div className="flex items-center gap-2">
                        <div className="w-16 bg-gray-200 rounded-full h-2">
                          <div className="bg-emerald-500 h-2 rounded-full" style={{ width: "45%" }}></div>
                        </div>
                        <span className="text-sm font-medium text-emerald-600">45%</span>
                      </div>
                    </div>

                    <div className="flex items-center justify-between">
                      <span className="text-sm text-gray-600">Çeşitlilik</span>
                      <div className="flex items-center gap-2">
                        <div className="w-16 bg-gray-200 rounded-full h-2">
                          <div className="bg-blue-500 h-2 rounded-full" style={{ width: "78%" }}></div>
                        </div>
                        <span className="text-sm font-medium text-blue-600">78%</span>
                      </div>
                    </div>
                  </div>
                </CardContent>
              </Card>
            </div>

            {/* Alerts and Notifications */}
            <AlertsAndNotifications payments={allPayments} credits={allCredits} creditCards={creditCards} />
          </TabsContent>
        </Tabs>
      </div>
    </div>
  )
}
